"MERGE (e:Article {id: \"Article_1624602\", title: \"VIPE: A NEW INTERACTIVE CLASSIFICATION FRAMEWORK FOR LARGE SETS OF SHORT TEXTS - APPLICATION TO OPINION MINING\", abstract: \"This paper presents a new interactive opinion mining tool that helps users to classify large sets of short texts originated from Web opinion polls , technical forums or Twitter . From a manual multi-label pre-classification of a very limited text subset , a new interactive opinion mining tool that helps users to classify large sets of short texts originated from Web opinion polls , technical forums or Twitter predicts the labels of the remaining texts of the corpus and the texts most likely associated to a selected label . Using a fast matrix factorization , a new interactive opinion mining tool that helps users to classify large sets of short texts originated from Web opinion polls , technical forums or Twitter is able to handle large corpora and is well-adapted to interactivity by integrating the corrections proposed by the users on the fly . Experimental results on classical datasets of various sizes and feedbacks of users from marketing services of the telecommunication company Orange confirm the quality of the obtained results .\", labels: [\"Industrial Digitalization\"], teams: [\"LS2N-DUKE\"]});"
"MATCH (s:Entity { id: \"Entity_interactive_opinion_mining_tool\" }) MATCH (o:Article { id: \"Article_1624602\" }) MERGE (s)-[:APPEARS_IN]->(o);"
"MERGE (e:Entity {id: \"Entity_web_opinion_polls\", name: \"web_opinion_polls\"});"
