FROM python:3.12-slim

WORKDIR /text2kg

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    PIP_ROOT_USER_ACTION=ignore \
    PIP_NO_CACHE_DIR=1

# --------------------------------------------------
# 1. System packages
#    Add build-essential here if a requirement fails with "gcc: not found".
# --------------------------------------------------
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip

# --------------------------------------------------
# 2. Heavy layer: torch + FAISS + PyG (CPU)
# --------------------------------------------------
COPY setup_cpu.sh ./
RUN bash setup_cpu.sh

# --------------------------------------------------
# 3. Project requirements (torch versions locked)
#    requirements.txt must not list faiss-gpu, nvidia-* or cupy.
# --------------------------------------------------
COPY requirements.txt ./
RUN python -m pip install -r requirements.txt -c /tmp/torch-constraints.txt && \
    python -m pip install --no-deps --force-reinstall numpy==2.2.6 pandas==2.2.3

# --------------------------------------------------
# 4. Checks (report only, never fail the build)
# --------------------------------------------------
RUN python -m pip check || echo "WARNING: pip check reported conflicts" ; \
    python -c "import torch, torchvision, faiss; print('torch', torch.__version__, '| torchvision', torchvision.__version__, '| faiss', faiss.__version__)"

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]