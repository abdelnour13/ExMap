FROM python:3.12-slim

WORKDIR /text2kg

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    PIP_ROOT_USER_ACTION=ignore \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip

# Heavy layer: torch + FAISS + PyG (cached unless setup.sh changes)
COPY setup.sh ./
RUN bash setup.sh

# Lighter layers
COPY requirements.txt ./
RUN python -m pip install -r requirements.txt -c /tmp/torch-constraints.txt && \
    python -m pip install --no-deps --force-reinstall numpy==2.2.6 pandas==2.2.3

COPY install_resources.sh ./
RUN bash install_resources.sh

RUN python -m pip check || echo "WARNING: pip check reported conflicts"

CMD ["tail", "-f", "/dev/null"]